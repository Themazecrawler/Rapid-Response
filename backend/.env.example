# Database Configuration
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=rapid_response_db
DB_PASSWORD=your_db_password
DB_PORT=5432
# Required in production when the database CA is not already trusted by the host OS.
# Keep certificate verification enabled; never use rejectUnauthorized=false.
DB_SSL_CA="-----BEGIN CERTIFICATE-----\nyour-ca-certificate\n-----END CERTIFICATE-----\n"

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=https://admin.example.edu
# Required in production to protect the Prometheus-compatible /metrics endpoint.
METRICS_BEARER_TOKEN=replace-with-a-long-random-token
ENABLE_SMS=true
ENABLE_PUSH_NOTIFICATIONS=true
OUTBOX_BATCH_SIZE=10

# Firebase Admin credentials (required). The mobile app authenticates with Firebase Auth
# directly; the backend verifies the ID token it sends using these service-account
# credentials. Generate a service account key in the Firebase console under
# Project Settings > Service Accounts, then copy its fields here.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"

# Twilio (optional). If unset, SMS confirmation on alert submission is silently skipped —
# useful for local dev. Get these from the Twilio Console.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555550100

# Real-time delivery and caching (all optional)
# ENABLE_REALTIME=false disables the SSE stream, long-poll endpoint and Postgres LISTEN.
# ENABLE_REALTIME=true
# MAX_REALTIME_CONNECTIONS=200
# ENABLE_CACHE=true
# STATS_CACHE_TTL_SECONDS=30
# CONTACTS_CACHE_TTL_SECONDS=60
# OUTBOX_RETENTION_DAYS=30

# Public HTTPS base URL of this API. Enables the Twilio delivery-status webhook
# (POST /api/v1/webhooks/twilio/status), verified with TWILIO_AUTH_TOKEN.
# PUBLIC_BASE_URL=https://api.example.com

# Rate limiting (all optional)
# Set TRUST_PROXY to the number of reverse proxies in front of the API (for example 1) so limits
# apply per client instead of per proxy. Leave unset when clients connect directly.
# TRUST_PROXY=1
# RATE_LIMIT_MAX=600
# ALERT_RATE_LIMIT_PER_HOUR=30
