{
  "name": "rapid-response-backend",
  "version": "1.0.0",
  "description": "Backend API for Rapid Response emergency alert system",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.scripts.json",
    "typecheck": "tsc --noEmit --project tsconfig.eslint.json",
    "check:env": "ts-node scripts/checkEnvExample.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"{src,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "format": "prettier --write \"{src,scripts}/**/*.ts\"",
    "format:check": "prettier --check \"{src,scripts}/**/*.ts\"",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:migrate:prod": "node dist-scripts/scripts/migrate.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "pg": "^8.11.3",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
