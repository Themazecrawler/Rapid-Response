# Database Configuration
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=rapid_response_db
DB_PASSWORD=your_db_password
DB_PORT=5432
# Required in production when the database CA is not already trusted by the host OS.
# Keep certificate verification enabled; never use rejectUnauthorized=false.
DB_SSL_CA="-----BEGIN CERTIFICATE-----\nyour-ca-certificate\n-----END CERTIFICATE-----\n"

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=https://admin.example.edu
# Required in production to protect the Prometheus-compatible /metrics endpoint.
METRICS_BEARER_TOKEN=replace-with-a-long-random-token
ENABLE_SMS=true
ENABLE_PUSH_NOTIFICATIONS=true
OUTBOX_BATCH_SIZE=10

# Firebase Admin credentials (required). The mobile app authenticates with Firebase Auth
# directly; the backend verifies the ID token it sends using these service-account
# credentials. Generate a service account key in the Firebase console under
# Project Settings > Service Accounts, then copy its fields here.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"

# Twilio (optional). If unset, SMS confirmation on alert submission is silently skipped —
# useful for local dev. Get these from the Twilio Console.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15555550100

